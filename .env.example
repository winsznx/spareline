# services/api (deploy/api.env on the VPS)
APP_ENV=production
DATABASE_URL=postgresql+psycopg://spareline:<password>@spareline-db:5432/spareline
ALLOWED_ORIGINS=https://<vercel-production-domain>
SESSION_SIGNING_KEY=<random 64 bytes>
PUBLIC_BASE_URL=https://<api-host>
SOLVER_WORKERS=2
# apps/web (Vercel production env)
NEXT_PUBLIC_API_BASE_URL=https://<api-host>/v1
